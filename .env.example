# Optional build-time defaults. Users can override these in the in-app Settings dialog.
# The app calls your endpoint directly from the browser (must allow CORS).
VITE_AI_BASE_URL=https://your-proxy.example.com/v1
VITE_AI_API_KEY=sk-xxxxxxxx
VITE_AI_MODEL=gpt-4o-mini

# "openai" = POST {baseUrl}/chat/completions  |  "gemini" = POST {baseUrl}/models/{model}:generateContent
# Leave empty to auto-detect from the base URL.
VITE_AI_PROVIDER=

# ---- voice announcement of the scan result -------------------------------
# "cloud"   = reuse the endpoint above: {baseUrl}/audio/speech (OpenAI) or
#             {baseUrl}/models/{model}:generateContent with AUDIO (Gemini)
# "browser" = device speech synthesis, free and offline
# "off"     = no audio (the text summary still reaches screen readers)
# Unknown or empty values default to "cloud".
VITE_TTS_ENGINE=cloud

# Cloud voice model and voice name. OpenAI: tts-1 / alloy.
# Gemini: gemini-2.5-flash-preview-tts / Kore.
VITE_TTS_MODEL=tts-1
VITE_TTS_VOICE=alloy

# Speaking rate for the browser engine, 0.5–2. Cloud engines ignore it.
VITE_TTS_RATE=1
